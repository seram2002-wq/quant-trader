# 한국투자증권 모의투자 (새 계좌로 발급한 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호 (12345678-01). 모의투자에 연결한 전략이 주문할 때 사용
KIS_ACCOUNT_NO=

# 접근 토큰은 data/.kis_token_mock.json에 자동으로 저장되므로 따로 적을 것이 없다.
# (토큰 파일 위치를 바꾸고 싶을 때만 KIS_TOKEN_FILE=경로 를 추가)

# 슬랙
SLACK_BOT_TOKEN=
MOCK_SLACK_CHANNEL=#seram-quant
PAPER_SLACK_CHANNEL=#paper-trading

# 팀 공유 (tools/team_export.py, 웹 전광판의 사람별 탭과 주간 랭킹). 비워 두면 내보내지 않는다
# TEAM_DIR: 구글 드라이브 PC 프로그램이 맞춰 주는 공유 폴더 (예: G:\내 드라이브\quant-team)
# TEAM_NAME: 공유 폴더 안의 내 폴더 이름 (예: 세람)
TEAM_DIR=
TEAM_NAME=

# 한국거래소 정보데이터시스템 (data.krx.co.kr, 무료 회원가입)
# tools/fetch_research_data.py가 과거 PER·PBR·배당, 외국인·기관 순매수를 받을 때 사용
# (로그인이 안 되면 비워 둔다. 장중 시세와 일별 시세는 로그인 없이 받음)
KRX_ID=
KRX_PW=

# DART 전자공시 인증키 (opendart.fss.or.kr). tools/fetch_dart.py가 과거 재무제표를 받을 때 사용
DART_API_KEY=

# 네이버 뉴스 검색 API: 네이버 클라우드 NAVER API HUB의 Application key
# (Client ID = X-NCP-APIGW-API-KEY-ID, Client Secret = X-NCP-APIGW-API-KEY). 옛 developers.naver.com 키는 안 됨.
# 비워 두면 뉴스 그림자 기록을 하지 않는다
# run.py의 NewsCheck가 뉴스 제목을 판정해 data/news/YYYYMMDD.csv에 쌓기만 한다 (매매에는 쓰지 않음)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 알파 마이너 (alpha_miner/mine.py)가 수식 후보를 받을 때 쓰는 OpenAI API
OPENAI_API_KEY=
# 비워 두면 gpt-4.1
OPENAI_MODEL=

# 퀀트 전광판
TEAM_NAME=이름
TEAM_DIR=